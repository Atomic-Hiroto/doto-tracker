# Required
BOT_TOKEN=your_discord_bot_token

# Optional: AI commands (+gpat, +analyze, +coach, +story). Get a key at https://openrouter.ai
OPENROUTER_API_KEY=
# Optional: richer match data for +analyze and the turbo studies. Get a key at https://stratz.com/api
STRATZ_API_KEY=
# Optional: higher OpenDota rate limits. https://www.opendota.com/api-keys
OPENDOTA_API_KEY=

# Your Discord user id. Unlocks owner-only commands (+setchannel, +turbobackfill, TI admin).
BOT_OWNER_ID=
# Command prefix, defaults to +
PREFIX=+

# Optional: The International auto-poster
TI_CHANNEL_ID=
TI_LEAGUE_ID=

# Optional: used by `npm run remote-deploy`
DOTO_DEPLOY_HOST=
DOTO_DEPLOY_KEY=
